{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path].js"
    },
    {
      "source": "/tours/:slug",
      "destination": "/tours/details.html"
    }
  ],
  "functions": {
    "api/[...path].js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
